# .env buat worker/poll-and-run.js — INI JALAN DI HOST VPS, bukan di container.

# Sama seperti DATABASE_URL utama, worker perlu akses langsung ke Postgres.
# Karena worker jalan di host (bukan di dalam Docker network shared-web-net),
# ini connect ke Postgres lewat port yang di-expose ke host, BUKAN nama container.
# Cek docker-compose.prod.yml Trackster buat port yang di-expose (kalau belum ada, tambahin
# "ports: - '5432:5432'" sementara ke service postgres Trackster, atau expose port khusus).
DATABASE_URL="postgresql://trackster:<password>@localhost:5432/ai_trackster"

# ==== Docker config buat agent container ====
AGENT_IMAGE=ai-trackster-agent-runner:latest
AGENT_MEMORY_LIMIT=768m
AGENT_NETWORK=ai-trackster-agent-net
AGENT_TIMEOUT_MS=7200000

# ==== DeepSeek RESMI (platform.deepseek.com, BUKAN reseller) ====
DEEPSEEK_API_KEY=isi-dari-platform.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ==== Git identity buat commit yang dibikin agent ====
GIT_AUTHOR_NAME=AI Trackster Agent
GIT_AUTHOR_EMAIL=ai-agent@trackster.my.id

# ==== SSH deploy key khusus buat push (BUKAN key personal kamu) ====
# Generate baru: ssh-keygen -t ed25519 -f ./ai-trackster-deploy-key -N ""
# Public key-nya didaftarkan sebagai Deploy Key di GitHub repo (Settings > Deploy keys, centang "Allow write access")
# Isi GIT_SSH_KEY dengan seluruh isi private key-nya. Worker otomatis nulis ini ke file
# terpisah sebelum di-mount ke container (bukan lewat env-file Docker, karena env-file
# tidak mendukung value multi-baris dengan baik).
GIT_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"

# ==== SSH deploy key KEDUA, khusus buat target self-edit (repo AI Trackster sendiri) ====
# GitHub NGGAK BOLEH satu public key yang sama didaftarin sebagai deploy key di 2 repo
# berbeda ("Key is already in use") -- makanya butuh key terpisah dari GIT_SSH_KEY di atas.
# Generate: ssh-keygen -t ed25519 -f ./ai-trackster-self-deploy-key -N ""
# Daftarin public key-nya ke repo trackster-ai (bukan Trackster), Allow write access.
# SELF_REPO_URL WAJIB SAMA PERSIS dengan yang di .env (root) backend, dipakai worker buat
# nentuin job ini self-edit atau bukan (lihat poll-and-run.js).
GIT_SSH_KEY_SELF="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"
SELF_REPO_URL=git@github.com:ArzakaRaffan/trackster-ai.git

MAX_AIDER_MESSAGES=40
