# ==== Database (numpang di Postgres Trackster, database terpisah) ====
DATABASE_URL="postgresql://trackster:<password_postgres_trackster>@postgres:5432/ai_trackster"

# ==== Auth ====
# JWT_SECRET buat sesi login biasa (3 user: arzaka, hamooy, zahara - lihat prisma/seed.js)
JWT_SECRET=ganti-dengan-random-string-panjang

# AGENT_ACCESS_SECRET = password KEDUA, cuma admin (arzaka) yang tau, wajib diisi tiap kali
# mau submit ide/approve/edit-plan/hapus job (aksi yang bisa trigger agent beneran ngedit kode).
# Generate: openssl rand -hex 16
AGENT_ACCESS_SECRET=ganti-dengan-openssl-rand-hex-16

COOKIE_DOMAIN=.trackster.my.id

# ==== Target repo yang mau dikerjain agent ====
TARGET_REPO_URL=git@github.com:ArzakaRaffan/trackster.git

# ==== Self-edit: repo AI Trackster sendiri (opsional, biar bisa dipilih di halaman submit ide) ====
# WAJIB daftarin public key ai-trackster-deploy-key.pub yang SAMA sebagai Deploy Key
# (Allow write access dicentang) di repo INI juga (Settings > Deploy keys), bukan cuma di Trackster.
# Kalau nggak diisi, opsi "AI Trackster (self-edit)" di UI bakal error saat disubmit.
SELF_REPO_URL=git@github.com:ArzakaRaffan/trackster-ai.git

# ==== Planner (Claude, via mwapi.dev reseller key - key BERBAYAR yang ada quota limit) ====
PLANNER_API_KEY=isi-dari-mwapi.dev
PLANNER_API_BASE_URL=https://api.mwapi.dev
PLANNER_MODEL=claude-sonnet-5

# ==== Chat biasa (via key GRATISAN/murah terpisah, banyak model - DeepSeek/Gemini/GPT/Kimi/dst) ====
# INI KEY BEDA dari PLANNER_API_KEY di atas — sengaja dipisah karena ini stakes-nya rendah
# (cuma buat ngobrol), sementara PLANNER_API_KEY yang berbayar dijaga ketat buat automation.
CHAT_API_KEY=isi-dari-kelontongai.my.id
CHAT_API_BASE_URL=https://api.kelontongai.my.id/v1

# ==== URLs ====
FRONTEND_URL=https://ai.trackster.my.id
NEXT_PUBLIC_API_URL=https://api.ai.trackster.my.id
